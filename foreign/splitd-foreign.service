[Unit]
Description=splitd v3 tunnel (foreign side)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
StandardOutput=null
StandardError=null
EnvironmentFile=/etc/splitd-v3/foreign.conf
ExecStart=/usr/local/bin/splitd-v3 -mode foreign -iran ${IRAN_HOST} -dlport ${DL_PORT} -ulport ${UL_PORT} -target ${TARGET} -flow-stale ${FLOW_STALE_SEC}
Restart=always
RestartSec=2
LimitNOFILE=1048576

[Install]
WantedBy=multi-user.target
